REM ************ INITIALISATION ***********
PROCEDURE initialisation
  REM --- 1. Déclaration des variables locales (Impératif au début) ---
  LOCAL i%,n2%,n3%,sw%,sx%,sy%
  
  REM --- 2. Gestion de la mémoire et du système ---
  ~FRE(0)
  RESERVE 100000      ! Réserve de la mémoire pour le GFA
  HIDEM               ! Cache la souris pour le jeu
  
  REM --- 3. Sauvegarde de la palette d'origine ---
  DIM old_pal%(16)
  FOR i%=0 TO 15
    old_pal%(i%)=XBIOS(7,i%,-1)
  NEXT i%
  
  REM --- 4. Adresses écrans et buffer d'effacement ---
  screen_addr%=XBIOS(3)
  blank_screen$=STRING$(32000,0)
  blank_addr%=V:blank_screen$
  
  REM --- 5. Chargement de la FONT (8x8) ---
  INLINE font_buffer%,32000
  IF EXIST("C:\REMNANT\GFX\FONT.pi1")
    OPEN "I",#1,"C:\REMNANT\GFX\FONT.pi1"
    SEEK #1,34
    BGET #1,font_buffer%,32000
    CLOSE #1
  ENDIF
  
  REM --- 6. Chargement des SPRITES ---
  spr_buffer%=MALLOC(32000)
  IF EXIST("C:\REMNANT\GFX\SPRITES.pi1")
    OPEN "I",#1,"C:\REMNANT\GFX\SPRITES.pi1"
    SEEK #1,34
    BGET #1,spr_buffer%,32000
    CLOSE #1
  ELSE
    PRINT "ERREUR: SPRITES.pi1 introuvable !"
    PAUSE 100
  ENDIF

  REM --- 7. Création des Look-Up Tables (LUT) pour les sprites ---
  REM On stocke X, Y, Largeur et Hauteur pour 310 sprites
  DIM spr_x%(309),spr_y%(309),spr_w%(309),spr_h%(309)
  
  FOR i%=0 TO 309
    IF i%<30
      REM --- Zone 32x32 (3 rangées de 10) ---
      sw%=32
      sx%=(i% MOD 10)*32
      sy%=(i% DIV 10)*32
    ELSE IF i%<110
      REM --- Zone 16x16 (4 rangées de 20) ---
      n2%=i%-30
      sw%=16
      sx%=(n2% MOD 20)*16
      sy%=96+(n2% DIV 20)*16    ! 96 = 3 lignes de 32
    ELSE
      REM --- Zone 8x8 (5 rangées de 40) ---
      n3%=i%-110
      sw%=8
      sx%=(n3% MOD 40)*8
      sy%=160+(n3% DIV 40)*8   ! 160 = 96 + (4 lignes de 16)
    ENDIF
    spr_x%(i%)=sx%
    spr_y%(i%)=sy%
    spr_w%(i%)=sw%
    spr_h%(i%)=sw%
  NEXT i%
  REM --- 8. Paramètres pour la procédure nprint ---
  DIM b%(15)
  b%(8)=3
  b%(1)=0
  b%(3)=15
  b%(10)=1
RETURN
