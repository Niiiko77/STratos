REM *************** LIGNECOULEUR ************
PROCEDURE lignecouleur
DIM a(8),b(8),c(8)
FOR f=0 TO 8
  a(f)=((f+1)*256+5*16+f) AND f<8
  b(f)=((7-(f+1)*256)+f*16+7) AND f<8
  c(f)=(7-(f+1)*16+f) AND f<8
NEXT f
FOR v=1 TO 999999 STEP 7
  FOR t=ABS(-200+v MOD 400) DOWNTO 1
  NEXT t
  FOR f=0 TO 8
    SETCOLOR t,a(f)
    SETCOLOR t,b(f)
    SETCOLOR t,c(f)
  NEXT f
  VSYNC
NEXT v
RETURN
REM ***************** NPRINT **************
PROCEDURE nprint(x%,y%,txt$)
  LOCAL l%,char%,sx%,sy%
  FOR l%=1 TO LEN(txt$)
    char%=ASC(MID$(txt$,l%,1))-32
    sy%=(char% DIV 20)*16
    sx%=(char% MOD 20)*16
    b%(0)=sx%
    b%(1)=sy%
    b%(2)=sx%+15
    b%(3)=sy%+15
    b%(4)=x%
    b%(5)=y%
    b%(6)=x%+15
    b%(7)=y%+15
    RC_COPY font_buffer%,sx%+4,sy%+6,8,8 TO screen_addr%,x%,y%,7
    ADD x%,8
  NEXT l%
RETURN
