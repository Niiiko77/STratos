REM *************** GET_PAL ***************
REM Lit uniquement la palette d'un PI1
REM ***************************************
> PROCEDURE get_pal(f$)
  LOCAL i%,p_data$
  IF EXIST(f$)
    OPEN "I",#1,f$
    SEEK #1,2
    p_data$=SPACE$(32)
    BGET #1,V:p_data$,32
    CLOSE #1
    FOR i%=0 TO 15
      ~XBIOS(7,i%,DPEEK(V:p_data$+i%*2))
    NEXT i%
  ELSE
    PRINT "Fichier ";f$;" absent !"
  ENDIF
RETURN
