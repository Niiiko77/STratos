REM *********************** AFFICHE ***********************
> PROCEDURE affiche(fichier$)
  LOCAL i%,p_addr%,p_data$
  IF EXIST(fichier$)
    OPEN "I",#1,fichier$
    SEEK #1,2
    p_data$=SPACE$(32)
    BGET #1,V:p_data$,32
    FOR i%=0 TO 15
      ~XBIOS(7,i%,DPEEK(V:p_data$+i%*2))
    NEXT i%
    BGET #1,screen_addr%,32000
    CLOSE #1
  ELSE
    PRINT "Erreur : Fichier ";fichier$;" introuvable !"
    PAUSE 50
  ENDIF
RETURN
REM
REM ******************* AFFSPRITE *******************
PROCEDURE affsprite(n%,x%,y%)
  IF n%>=0 AND n%<310
    RC_COPY spr_buffer%,spr_x%(n%),spr_y%(n%),spr_w%(n%),spr_h%(n%) TO screen_addr%,x%,y%,13
  ENDIF
RETURN
REM
REM *************** CLOTURE ***************
> PROCEDURE cloture
  FOR i%=0 TO 15
    ~XBIOS(7,i%,old_pal%(i%))
  NEXT i%
  SHOWM
  EDIT
RETURN
REM
REM **************** EFFACE ***************
> PROCEDURE efface
  BMOVE blank_addr%,screen_addr%,32000
RETURN
